# LandProof Environment Configuration (Example)
# This prototype runs entirely client-side with persistent storage, Web Crypto API, and OpenStreetMap tiles.

# Port for local development
VITE_PORT=5173

# Optional base path for deployment (e.g. GitHub Pages or subpath)
VITE_BASE_PATH=/

# Public map tile provider URL template (Defaults to OpenStreetMap)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
