# SmartBhumi Environment Configuration (Example)
# SYNTHETIC DEMO ONLY - Never commit real secrets, API keys, or private keys.

# Server Port (default: 3000)
PORT=3000

# Client development server port
VITE_PORT=5173

# Base path for deployment
VITE_BASE_PATH=/

# Public map tile provider URL template (Defaults to OpenStreetMap)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Optional OCR feature flag (default: false for fast synthetic offline evaluation)
ENABLE_REAL_OCR=false
